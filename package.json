{
  "name": "ragazzi",
  "version": "0.6.1",
  "private": true,
  "main": "public/electron.js",
  "homepage": "./",
  "license": "MIT",
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "aedes": "^1.1.1",
    "aedes-stats": "^4.0.0",
    "date-fns": "^2.13.0",
    "dotenv": "^8.2.0",
    "json-edit-react": "^1.30.2",
    "mqtt": "^3.0.0",
    "portscanner": "^2.2.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-dropzone": "^10.2.2",
    "react-redux": "^7.2.0",
    "react-router-dom": "^5.1.2",
    "redux": "^4.0.5",
    "redux-observable": "^1.2.0",
    "rxjs": "^6.5.5",
    "websocket-stream": "^5.5.2",
    "zustand": "^3.7.2"
  },
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.electron.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "preview": "vite preview",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "pretest:e2e": "npm run build:electron",
    "test:e2e": "node ./node_modules/@playwright/test/cli.js test",
    "pretest:e2e:smoke": "npm run build:electron",
    "test:e2e:smoke": "node ./node_modules/@playwright/test/cli.js test --project=smoke",
    "preelectron-dev": "npm run build:electron",
    "electron-dev": "concurrently \"npm start\" \"wait-on http://localhost:3000 && electron .\"",
    "preelectron-build": "npm run build:electron && npm run build && cp ./public/entitlements.mac.plist ./build",
    "electron-build": "electron-builder -wl",
    "prepare": "husky"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.0",
    "@playwright/test": "^1.61.1",
    "@types/mqtt": "^0.0.34",
    "@types/node": "^26.1.1",
    "@types/portscanner": "^2.1.4",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/react-redux": "^7.1.34",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.7",
    "concurrently": "^5.1.0",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.28.1",
    "husky": "^9.1.7",
    "typescript": "^7.0.2",
    "vite": "^6.3.5",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vitest": "^3.2.7",
    "wait-on": "^4.0.1"
  },
  "build": {
    "appId": "com.thomasgeissl.ragazzi",
    "productName": "ragazzi",
    "copyright": "Copyright © 2022",
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "icon": "build/icon.png"
    },
    "win": {
      "target": "portable",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "icon": "build/icon.png"
    },
    "files": [
      "build/**/*",
      "public/electron.js",
      "public/preload.js",
      "node_modules/**/*"
    ],
    "directories": {
      "buildResources": "build"
    },
    "afterSign": "scripts/notarize.js"
  }
}
